# Server-side URL for the LMIO FastAPI runtime.
# This value is not a credential.
LMIO_API_BASE_URL=http://127.0.0.1:8000

# Server-side credential shared with the LMIO runtime. Never expose it through
# a NEXT_PUBLIC_ variable.
LMIO_READ_API_KEY=

# Bayview OS Supabase identity configuration. The publishable key is intended
# for browser authentication; the service-role key must never be used here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
