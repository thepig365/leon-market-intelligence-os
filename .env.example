# LMIO local foundation settings.
# Copy to .env only for local development. Never commit secrets.

LMIO_ENVIRONMENT=local
LMIO_DEFAULT_LANGUAGE=zh-CN
LMIO_MARKET=US_EQUITIES

# Hard safety boundaries. The application rejects startup if any are true.
CAN_TRADE=false
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=false

# Local versioned runtime store. Production may use the isolated, service-role
# only LMIO tables in the approved Bayview Supabase project.
LMIO_STORE_BACKEND=sqlite
LMIO_DATABASE_PATH=var/lmio.sqlite3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared server-to-server credential used only between the protected dashboard
# and the LMIO runtime. Generate a long random value for non-local environments.
LMIO_READ_API_KEY=

# Optional read-only/reporting integrations. Leave blank until configured.
SEC_USER_AGENT=
LMIO_SEC_WATCHLIST=AAPL:320193,META:1326801
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Finviz Elite official API access. Keep the generated token server-side only.
FINVIZ_API_TOKEN=

# Protects the scheduled server-to-server refresh request.
CRON_SECRET=

# Optional server-side research synthesis. Both values are required before the
# adapter becomes configured, and configuration alone is never reported as ready.
# No model is selected by default and no API call is made by the foundation.
OPENAI_API_KEY=
LMIO_OPENAI_MODEL=

# Required before enabling mutating HTTP endpoints outside a trusted local CLI.
LMIO_ADMIN_API_KEY=
